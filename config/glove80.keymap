/*
 * Glove80 keymap for asadler -- nvim + omarchy/Hyprland optimized.
 * Build: fork moergo-sc/glove80-zmk-config, put this in config/glove80.keymap,
 * push, grab glove80.uf2 from Actions, flash each half.
 *
 * HRM on A/S/D/F + J/K/L/;, thumbs = space(x2)/enter/backspace/SYM/NAV/FN/WM/WM-move,
 * Esc = J+K combo or right-middle thumb key, tmux command mode = hold the
 * right-thumb inner key (tap = space): while held, each key sends
 * prefix+command (e.g. = -> backtick+equal, % -> backtick+%, " -> backtick+").
 * Delete on NAV, WM layers emit SUPER+numpad (matches ~/.config/hypr/bindings.lua
 * numpad workspace grid): 1/2/3 on J/K/L, 4/5/6 on M/,/., 7/8/9 on U/I/O.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define SYM 1
#define NAV 2
#define WM 3
#define WMMV 4
#define FN 5
#define MAGIC 6
#define TMUX 7

/ {
    behaviors {
        hrm: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp &kp>;
        };
        tmux_lt: tmux_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "TMUX_LT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            bindings = <&mo &kp>;
        };
        tmux_eq: tmux_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp EQUAL>;
        };
        tmux_dquote: tmux_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp LS(N2)>;
        };
        tmux_pct: tmux_pct {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp LS(N5)>;
        };
        tmux_c: tmux_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp C>;
        };
        tmux_n: tmux_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp N>;
        };
        tmux_p: tmux_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp P>;
        };
        tmux_w: tmux_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp W>;
        };
        tmux_o: tmux_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp O>;
        };
        tmux_z: tmux_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp Z>;
        };
        tmux_d: tmux_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp D>;
        };
        tmux_x: tmux_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp X>;
        };
        tmux_dash: tmux_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp MINUS>;
        };
        tmux_h: tmux_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp H>;
        };
        tmux_j: tmux_j {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp J>;
        };
        tmux_k: tmux_k {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp K>;
        };
        tmux_l: tmux_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp L>;
        };
        tmux_s: tmux_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp S>;
        };
        caps_word: caps_word {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
            &kp EQUAL &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
            &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSLH
            &caps_word &hrm LCTRL A &hrm LGUI S &hrm LALT D &hrm LSHFT F &kp G &kp H &kp J &kp K &hrm RSHFT L &hrm RCTRL SEMI &kp SQT
            &kp GRAVE &kp Z &kp X &kp C &kp V &kp B &mo SYM &mo NAV &tmux_lt TMUX SPACE &mo FN &kp ESC &mo WMMV &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp PG_UP
            &none &none &kp DEL &kp LEFT &kp RIGHT &kp LGUI &kp BSPC &mo WM &kp DEL &kp SPACE &kp RET &kp UP &kp DOWN &kp LBKT &kp RBKT &kp PG_DN
            >;
        };

        sym_layer {
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCT &kp CARET &kp AMPS &kp ASTERISK &kp TILDE &kp PIPE &kp UNDER
            &trans &trans &kp LT &kp GT &kp PLUS &kp EQUAL &trans &trans &trans &trans &trans &trans
            &trans &kp LPAR &kp RPAR &kp LBRC &kp RBRC &kp LBKT &kp RBKT &kp FSLH &kp BSLH &kp COLON &kp GRAVE
            &kp MINUS &trans &kp PLUS &kp EQUAL &kp UNDER &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        nav_layer {
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &kp HOME &trans &kp LC(LEFT) &kp LC(RIGHT) &kp END &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LC(UP) &kp LC(DOWN)
            &kp PG_UP &trans &kp DEL &trans &trans &kp PG_DN &trans &trans &kp SPACE &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp RET &trans &trans &trans &trans &trans &trans
            >;
        };

        wm_layer {
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &kp LG(KP_N7) &kp LG(KP_N8) &kp LG(KP_N9) &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &kp LG(KP_N1) &kp LG(KP_N2) &kp LG(KP_N3) &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp LG(KP_N4) &kp LG(KP_N5) &kp LG(KP_N6) &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        wmmv_layer {
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &kp LG(LS(KP_N7)) &kp LG(LS(KP_N8)) &kp LG(LS(KP_N9)) &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &kp LG(LS(KP_N1)) &kp LG(LS(KP_N2)) &kp LG(LS(KP_N3)) &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp LG(LS(KP_N4)) &kp LG(LS(KP_N5)) &kp LG(LS(KP_N6)) &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        fn_layer {
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
            &trans &kp F12 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &kp C_MUTE &kp C_VOLUME_DOWN &kp C_VOLUME_UP &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &kp C_BRI_DEC &kp C_BRI_INC &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &mo MAGIC &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        magic_layer {
            bindings = <
            &bt BT_CLR &none &none &none &none &none &none &none &none &bt BT_CLR_ALL
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG &none &none &none &none &none &none
            &bootloader &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF &none &none &none &none &none &bootloader
            &sys_reset &none &none &none &none &none &bt BT_SEL 2 &bt BT_SEL 3 &none &none &none &none &none &none &none &none &none &none
            &sys_reset &none &none &none &none &none &bt BT_SEL 0 &bt BT_SEL 1 &out OUT_USB &none &none &none &none &none &none &none
            >;
        };

        tmux_layer {
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &tmux_dquote &trans &trans &tmux_pct &trans &trans &trans &trans &trans &trans
            &trans &trans &tmux_w &trans &trans &trans &trans &trans &trans &tmux_o &tmux_p &trans
            &trans &trans &tmux_s &trans &trans &trans &tmux_h &tmux_j &tmux_k &tmux_l &trans &trans
            &trans &tmux_z &tmux_x &tmux_c &trans &trans &tmux_dash &trans &trans &tmux_eq &tmux_x &tmux_c &trans &tmux_n &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

    };
};
